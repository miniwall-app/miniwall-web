{
  "name": "@miniwall/web",
  "version": "0.1.0",
  "description": "Web SDK: render paywalls built in the dashboard on any website. No Svelte or framework required.",
  "license": "MIT",
  "author": "Miniwall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miniwall-app/miniwall-web.git"
  },
  "homepage": "https://github.com/miniwall-app/miniwall-web#readme",
  "bugs": {
    "url": "https://github.com/miniwall-app/miniwall-web/issues"
  },
  "keywords": [
    "paywall",
    "onboarding",
    "subscriptions",
    "web",
    "sdk",
    "no-code"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./iife": "./dist/ui-kit.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode iife && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:pack": "node scripts/check-pack.mjs",
    "test:e2e": "pnpm build && pnpm check:pack && playwright test",
    "prepublishOnly": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||''))throw new Error('publish with pnpm: it rewrites the workspace: versions npm would leave')\" && pnpm run build && pnpm run check:pack && pnpm run test"
  },
  "dependencies": {
    "@miniwall/render": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "typescript": "^5",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  },
  "unpkg": "./dist/ui-kit.iife.js",
  "jsdelivr": "./dist/ui-kit.iife.js",
  "publishConfig": {
    "access": "public"
  }
}
